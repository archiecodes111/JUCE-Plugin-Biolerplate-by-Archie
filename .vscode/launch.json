{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Standalone (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/SimpleGainPlugin_artefacts/${command:cmake.buildType}/Standalone/Simple Gain Plugin.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "externalTerminal"
    },
    {
      "name": "Debug Standalone (macOS / Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/SimpleGainPlugin_artefacts/${command:cmake.buildType}/Standalone/Simple Gain Plugin",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb"
    },
    {
      "name": "Attach to DAW (Reaper / FL Studio / Ableton)",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
